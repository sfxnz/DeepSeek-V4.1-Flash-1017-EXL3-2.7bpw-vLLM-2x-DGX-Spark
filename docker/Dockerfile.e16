# e16-rows (perf2 c4-kernels): e15-kbits + widen_p2b_rows.py, the native decode MoE past 8 rows.
#   - vllm_exl3 / vllm_exl3_c rebuilt from the same vllm-exl3 pin and the same p2b chain as
#     docker/Dockerfile.e15, plus widen_p2b_rows.py: the native decode MoE takes 1..24 rows, and
#     m * top_k in (64, 144] (9..24 rows at top-6) launches p2b_coop_dfw_kernel<BITS, 1>, the dataflow
#     kernel with a 144-pair sort cap (same tiles: every row's bits are the ones the m <= 8 kernel gives
#     it) under DSV41_P2B_COOP=2. The plugin sends those rows native unless DSV41_P2B_WIDE=0 (then 9..24
#     rows run exl3_moe / exl3_moe_kmix as on e15-kbits). The 42 p2b kernels of e15-kbits keep
#     byte-identical machine code (kernel_study/p2b_rows/sass_identity_rows.sh); 9 are new.
#   - b12x MXFP8 dense needs no stage: at 9..24 rows its (32, 128) tile streams as fast as the m <= 8
#     tiles (kernel_study/dense_gemv/rows16_check.py, 2026-10-19: within -2.4..+2.0 % per shape).
# The JIT levers (dense_gemv, indexer_wp_gemv, candidate_mask_bounded, mhc_det, moe_prep_fused) compile
# from the mounted docker/patch and need no build stage. docker/Dockerfile builds the same image from the
# pinned base digest (tests/test_widen_p2b_dataflow.py keeps the chains in sync).
#   docker build --memory 24g --memory-swap 24g -f docker/Dockerfile.e16 -t dsv41-flash-exl3-sm121:e16-rows \
#     --build-arg DSV41_GIT_REV=$(git rev-parse HEAD) \
#     --build-arg DSV41_TREE_DIFF=$(git diff HEAD --binary -- docker | sha256sum | cut -c1-64) docker
FROM dsv41-flash-exl3-sm121:e15-kbits

COPY patch /opt/dsv41-patch

# Same pin as docker/Dockerfile.e15
ARG VLLM_EXL3_REF=d3cfd394920360d69f820d2dc96f8292a9e10283
RUN apt-get update \
 && apt-get install -y --no-install-recommends git \
 && git clone https://github.com/vcruz305/vllm-exl3.git /opt/vllm-exl3 \
 && git -C /opt/vllm-exl3 checkout "$VLLM_EXL3_REF" \
 && python3 /opt/dsv41-patch/fix_vllm_exl3_setup.py /opt/vllm-exl3/setup.py \
 && python3 /opt/dsv41-patch/widen_p2b_shapes.py /opt/vllm-exl3 \
 && python3 /opt/dsv41-patch/widen_p2b_mrow.py /opt/vllm-exl3 \
 && python3 /opt/dsv41-patch/widen_p2b_cfg1.py /opt/vllm-exl3 \
 && python3 /opt/dsv41-patch/widen_p2b_codebook.py /opt/vllm-exl3 \
 && python3 /opt/dsv41-patch/widen_p2b_fshift.py /opt/vllm-exl3 \
 && python3 /opt/dsv41-patch/widen_p2b_srcsort.py /opt/vllm-exl3 \
 && python3 /opt/dsv41-patch/widen_p2b_coop.py /opt/vllm-exl3 \
 && python3 /opt/dsv41-patch/widen_p2b_dataflow.py /opt/vllm-exl3 \
 && python3 /opt/dsv41-patch/widen_p2b_kbits.py /opt/vllm-exl3 \
 && python3 /opt/dsv41-patch/widen_p2b_rows.py /opt/vllm-exl3 \
 && TORCH_CUDA_ARCH_LIST=12.1a python3 -m pip install --no-build-isolation --no-deps --force-reinstall /opt/vllm-exl3 \
 && python3 -c "import torch, vllm_exl3, vllm_exl3_c; so = open(vllm_exl3_c.__file__, 'rb').read(); assert hasattr(vllm_exl3_c, 'p2b_fused_moe'); assert b'DSV41_P2B_SRC_SORT' in so and b'DSV41_P2B_COOP' in so and b'p2b coop dataflow kernel engaged' in so; assert b'p2b_coop_df_kernelILi23ELi1E' in so and b'p2b_coop_df_kernelILi4ELi1E' in so; assert hasattr(vllm_exl3_c, 'exl3_moe_kmix'); import vllm_exl3.exl3 as e; assert hasattr(e.Exl3Config, 'expert_bits_for_prefix'); assert b'p2b_coop_dfw_kernelILi2ELi1E' in so and b'p2b_coop_dfw_kernelILi23ELi1E' in so and b'p2b coop dataflow wide kernel engaged' in so; assert vllm_exl3_c.P2B_WIDE_ROWS == 24; assert hasattr(e, '_native_moe_wide_rows'); print('vllm_exl3 rows cuda ok')" \
 && rm -rf /opt/vllm-exl3 /var/lib/apt/lists/*

RUN cp /opt/dsv41-patch/sitecustomize.py /usr/lib/python3.12/sitecustomize.py \
 && python3 -m py_compile /usr/lib/python3.12/sitecustomize.py
LABEL dsv41.recipe.patches="shapes,mrow,cfg1,codebook,fshift,srcsort,coop,dataflow,kbits,rows,b12x_smalls,fix_o_proj_woa_fp8,woa_prepack"
# Build provenance: git HEAD and sha256 of `git diff HEAD --binary -- docker` (uncommitted build context).
ARG DSV41_GIT_REV=unknown
ARG DSV41_TREE_DIFF=unknown
LABEL dsv41.recipe.git_rev="$DSV41_GIT_REV" dsv41.recipe.tree_diff_sha256="$DSV41_TREE_DIFF"
